# KnowStruct 后端环境变量
# 复制此文件为 .env 并修改配置

# 应用
APP_NAME=KnowStruct
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# 数据库 (MySQL)
DATABASE_URL=mysql+aiomysql://knowstruct:knowstruct@localhost:3306/knowstruct

# 认证会话
SESSION_COOKIE_NAME=knowstruct_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
REMEMBER_SESSION_DAYS=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
TRUSTED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string

# OSS (阿里云)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# 附件本地存储
STORAGE_DIR=data/attachments
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=4096

# AI Providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428

# 用户级 AI 配置加密密钥（生产建议显式配置；缺省由 SECRET_KEY 派生）
AI_CONFIG_ENCRYPTION_KEY=
