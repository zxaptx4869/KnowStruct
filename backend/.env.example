# KnowStruct 后端环境变量
# 复制此文件为 .env 并修改配置

# 应用
APP_NAME=KnowStruct
APP_VERSION=0.1.0
DEBUG=true

# 数据库 (MySQL)
DATABASE_URL=mysql+aiomysql://knowstruct:knowstruct@localhost:3306/knowstruct

# JWT
SECRET_KEY=change-me-in-production

# OSS (阿里云)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# AI Providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
